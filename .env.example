# Conectividad Rural Landing Page
# Environment Variables Example

# Site URL used for canonical links, sitemap, RSS feeds and OG images.
# In production this should be the public URL of the site.
NEXT_PUBLIC_SITE_URL=https://www.inverseneurallab.com

# Pablo's Medium — public author page used by the blog "follow / read more" CTA
NEXT_PUBLIC_MEDIUM_URL=https://medium.com/@pablo-toksol

# Pablo's LinkedIn — used by the blog FollowCTA and JSON-LD author entries
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/pablo-f-acebedo/

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Form submission endpoint (FormSpree, Netlify Forms, etc.)
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxx

# Optional: Contact email
# NEXT_PUBLIC_CONTACT_EMAIL=contacto@conectividad-rural.org
